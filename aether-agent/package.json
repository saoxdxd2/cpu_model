{
  "name": "aether-agent",
  "displayName": "Aether AI Agent",
  "description": "Continuous Silicon Intelligence Agent",
  "version": "1.0.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Machine Learning"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aether.start",
        "title": "Aether: Start Continuous Agent"
      },
      {
        "command": "aether.stop",
        "title": "Aether: Stop Agent"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/vscode": "^1.80.0",
    "@types/node": "^18.0.0",
    "@types/ws": "^8.5.5",
    "typescript": "^5.1.3"
  },
  "dependencies": {
    "ws": "^8.13.0"
  }
}
